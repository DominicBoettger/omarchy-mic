# Shure MV7 - allow user access to HID interface
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="14ed", ATTRS{idProduct}=="1012", MODE="0666"

# Shure MV7 - auto-setup on plug/unplug (run as user via systemd)
ACTION=="add", SUBSYSTEM=="sound", ATTRS{idVendor}=="14ed", ATTRS{idProduct}=="1012", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}="omarchy-mic-setup.service"
ACTION=="remove", SUBSYSTEM=="sound", ATTRS{idVendor}=="14ed", ATTRS{idProduct}=="1012", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}="omarchy-mic-setup.service"
